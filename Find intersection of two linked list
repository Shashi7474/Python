class Node:
    def __init__(self, data):
        self.data = data
        self.next = None


def intersection(head1, head2):
    p = head1
    q = head2

    while p != q:
        p = p.next if p else head2
        q = q.next if q else head1

    return p


common = Node(30)
common.next = Node(40)

a = Node(10)
a.next = Node(20)
a.next.next = common

b = Node(15)
b.next = common

result = intersection(a, b)

print(result.data)
