matrix = [
    [0, 1, 1],
    [0, 0, 1],
    [0, 0, 0]
]

n = len(matrix)

candidate = 0

for i in range(1, n):
    if matrix[candidate][i] == 1:
        candidate = i

for i in range(n):
    if i != candidate:
        if matrix[candidate][i] == 1 or matrix[i][candidate] == 0:
            print("No Celebrity")
            break
else:
    print("Celebrity:", candidate)
